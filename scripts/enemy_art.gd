extends RefCounted
## Distinct silhouettes and details for each dungeon's native creatures.
static func humanoid(a,x,y,skin,cloth):
	a.rect(x-10,y-13,20,17,skin)
	a.rect(x-11,y+4,22,17,cloth)
	a.rect(x-15,y+6,5,14,skin)
	a.rect(x+11,y+5,5,14,skin)
	a.rect(x-8,y+20,6,8,cloth.darkened(0.3))
	a.rect(x+4,y+20,6,8,cloth.darkened(0.3))
	a.rect(x-6,y-7,4,3,"ink")
	a.rect(x+3,y-7,4,3,"ink")
static func beast(a,x,y,coat,accent):
	a.rect(x-19,y+6,35,14,coat)
	a.rect(x-24,y-5,14,18,coat)
	a.rect(x-28,y+3,10,6,accent)
	a.rect(x-23,y-12,5,10,coat)
	a.rect(x-13,y-10,5,8,coat)
	a.rect(x-22,y-1,3,3,"red")
	for i in range(3): a.rect(x-16+i*13,y+18,5,9,coat)
	a.rect(x+15,y+2,16,6,coat)
	a.rect(x+26,y-5,5,10,accent)
static func brute(a,x,y,body,accent):
	a.rect(x-13,y-18,27,19,body)
	a.rect(x-20,y+1,40,22,body)
	a.rect(x-27,y+2,9,23,body.darkened(0.2))
	a.rect(x+19,y+2,9,23,body.darkened(0.2))
	a.rect(x-16,y+23,11,9,body)
	a.rect(x+6,y+23,11,9,body)
	a.rect(x-9,y-12,5,4,accent)
	a.rect(x+5,y-12,5,4,accent)
static func wings(a,x,y,body,wing):
	var flap = floor(sin(a.time*9)*4)
	for side in [-1,1]:
		var bx = x-30 if side<0 else x+7
		a.rect(bx,y-14+flap,23,22,wing)
		a.rect(bx+4,y+5+flap,16,12,wing.darkened(0.15))
		a.rect(bx+8,y-9+flap,8,13,wing.lightened(0.3))
	a.rect(x-6,y-12,13,33,body)
	a.rect(x-4,y-17,9,10,body)
	a.rect(x-5,y-13,3,3,"red")
	a.rect(x+3,y-13,3,3,"red")
static func crown(a,x,y):
	a.rect(x-12,y-19,25,6,"gold")
	for i in range(3): a.rect(x-12+i*10,y-26,5,9,"gold")
	a.rect(x-2,y-18,4,4,"red")
static func draw(a,kind,x,y):
	match kind:
		"ghoul":
			humanoid(a,x,y+3,Color(0.45,0.58,0.38),Color(0.25,0.22,0.31))
			a.rect(x-21,y+8,13,5,Color(0.45,0.58,0.38))
			a.rect(x-25,y+8,5,10,"dim")
			a.rect(x-8,y-1,18,4,"ink")
			for i in range(4): a.rect(x-6+i*4,y-1,2,3,"text")
		"zombie":
			humanoid(a,x,y,Color(0.43,0.59,0.52),Color(0.28,0.36,0.48))
			a.rect(x-11,y-15,12,6,"dim")
			a.rect(x+1,y-10,7,5,"red")
			a.rect(x-5,y+7,12,3,"ink")
			a.rect(x-17,y-2,6,13,Color(0.43,0.59,0.52))
		"bonebat":
			wings(a,x,y-6,Color(0.79,0.76,0.64),Color(0.34,0.25,0.41))
			for i in range(4): a.rect(x-8,y-6+i*5,17,2,"text")
			a.rect(x-4,y-18,3,7,"text")
			a.rect(x+3,y-18,3,7,"text")
		"gravekeeper":
			humanoid(a,x,y,Color(0.66,0.66,0.53),Color(0.27,0.23,0.38))
			a.rect(x-13,y-19,26,8,Color(0.27,0.23,0.38))
			a.rect(x-6,y-7,13,5,"ink")
			a.rect(x+22,y-19,3,41,Color(0.48,0.34,0.24))
			a.rect(x+17,y+16,13,14,"dim")
			a.rect(x-7,y+11,14,2,"gold")
		"emberimp":
			humanoid(a,x,y,Color(0.9,0.30,0.13),Color(0.47,0.16,0.16))
			a.rect(x-13,y-23,5,13,"gold")
			a.rect(x+8,y-23,5,13,"gold")
			a.rect(x+17,y+16,13,4,"L")
			a.rect(x+26,y+8,4,11,"gold")
			a.rect(x-6,y-6,4,3,"gold")
			a.rect(x+3,y-6,4,3,"gold")
		"cinderhound":
			beast(a,x,y,Color(0.28,0.19,0.20),Color(1,0.42,0.15))
			for i in range(4): a.rect(x-12+i*7,y-3,4,12+floor(sin(a.time*10+i)*3),"L")
			a.rect(x-5,y+10,17,3,"gold")
		"magmaslime":
			a.rect(x-23,y+12,46,14,Color(0.55,0.16,0.12))
			a.rect(x-17,y+1,34,22,"L")
			a.rect(x-10,y-6,20,8,"gold")
			a.rect(x-11,y+9,5,5,"ink")
			a.rect(x+6,y+9,5,5,"ink")
			for i in range(4): a.rect(x-15+i*9,y+20,4,6,"gold")
			a.rect(x-2,y-13+sin(a.time*4)*3,4,4,"L")
		"furnacegolem":
			brute(a,x,y,Color(0.30,0.28,0.30),Color(1,0.62,0.16))
			a.rect(x-12,y+5,25,16,"L")
			for i in range(4): a.rect(x-10+i*7,y+5,3,16,"ink")
			a.rect(x-6,y-27,12,10,"edge")
			a.rect(x-3,y-34,6,8,"L")
		"acidcrawler":
			for i in range(4):
				var bx = x-22+i*12
				a.rect(bx,y+4,11,15,Color(0.37+i*0.06,0.51+i*0.04,0.18))
				a.rect(bx+3,y+18,3,9,"green")
				a.rect(bx+1,y+1,7,3,"gold")
			a.rect(x-28,y+7,6,8,"green")
			a.rect(x-28,y+8,2,2,"red")
			a.rect(x-26,y-5,2,12,"green")
		"sewerleech":
			for i in range(6):
				var by = y+10+floor(sin(a.time*5+i)*3)
				a.rect(x-27+i*9,by,11,14,Color(0.43,0.40,0.19))
				a.rect(x-25+i*9,by,2,14,Color(0.66,0.71,0.32))
			a.rect(x-31,y+9,9,17,"red")
			a.rect(x-32,y+12,7,10,"ink")
			a.rect(x-31,y+12,3,3,"text")
		"bogtoad":
			a.rect(x-21,y+4,42,21,Color(0.33,0.52,0.19))
			a.rect(x-16,y-5,12,14,"green")
			a.rect(x+5,y-5,12,14,"green")
			a.rect(x-12,y-1,4,5,"ink")
			a.rect(x+9,y-1,4,5,"ink")
			a.rect(x-25,y+18,13,9,"green")
			a.rect(x+13,y+18,13,9,"green")
			a.rect(x-12,y+13,24,3,"ink")
			a.rect(x-24,y+9,5,4,"gold")
		"oozebrute":
			brute(a,x,y,Color(0.39,0.47,0.18),Color(0.88,1,0.30))
			for i in range(5): a.rect(x-20+i*9,y+12,4,15+int(sin(a.time*4+i)*4),"green")
			a.rect(x-6,y-3,13,5,"ink")
			a.rect(x+15,y-2,5,9,"gold")
		"frostmoth":
			wings(a,x,y-5,Color(0.65,0.81,0.91),Color(0.32,0.54,0.73))
			a.rect(x-24,y-6,11,3,"text")
			a.rect(x+13,y-6,11,3,"text")
			a.rect(x-20,y-10,3,12,"text")
			a.rect(x+17,y-10,3,12,"text")
		"icewolf":
			beast(a,x,y,Color(0.76,0.86,0.91),Color(0.37,0.65,0.83))
			a.rect(x-5,y+1,4,15,"I")
			a.rect(x+4,y+2,4,14,"I")
			a.rect(x-22,y-1,3,3,"I")
		"snowrevenant":
			humanoid(a,x,y-2,Color(0.58,0.76,0.85),Color(0.34,0.50,0.64))
			a.rect(x-13,y-20,26,11,Color(0.75,0.86,0.90))
			a.rect(x-7,y-10,15,7,"ink")
			a.rect(x-5,y-7,4,3,"I")
			a.rect(x+3,y-7,4,3,"I")
			for i in range(4): a.rect(x-12+i*7,y+17,4,12-floor(sin(a.time*5+i)*3),"I",0.65)
		"frostgiant":
			brute(a,x,y,Color(0.48,0.68,0.80),Color(0.83,0.97,1))
			a.rect(x-24,y-7,7,14,"I")
			a.rect(x+17,y-11,7,18,"I")
			a.rect(x-8,y-27,6,12,"text")
			a.rect(x+3,y-23,6,9,"text")
			a.rect(x-9,y+7,19,4,"I")
		"royalguard":
			humanoid(a,x,y,Color(0.79,0.66,0.34),Color(0.46,0.34,0.51))
			a.rect(x-12,y-17,25,7,"gold")
			a.rect(x-7,y-8,15,3,"ink")
			a.rect(x-25,y+2,17,22,"gold")
			a.rect(x-22,y+5,11,16,"T")
			a.rect(x+22,y-27,3,53,"gold")
			a.rect(x+19,y-28,9,9,"text")
		"courtmage":
			humanoid(a,x,y,Color(0.68,0.58,0.56),Color(0.43,0.23,0.52))
			a.rect(x-13,y-18,26,7,"T")
			a.rect(x-5,y-31,12,15,"T")
			a.rect(x-3,y+4,5,22,"gold")
			a.rect(x+22,y-15,3,42,"gold")
			a.rect(x+17,y-23,13,12,"T")
			a.rect(x+21,y-20,5,5,"text")
		"crownmimic":
			a.rect(x-24,y+1,48,24,Color(0.43,0.24,0.32))
			a.rect(x-25,y-8,50,11,"gold")
			a.rect(x-21,y+6,42,9,"ink")
			for i in range(7):
				a.rect(x-19+i*6,y+5,3,6,"text")
				a.rect(x-16+i*6,y+12,3,4,"text")
			crown(a,x,y+5)
			a.rect(x-22,y+23,8,6,"T")
			a.rect(x+14,y+23,8,6,"T")
		"fallenregent":
			a.rect(x-23,y-2,46,32,Color(0.48,0.12,0.22))
			humanoid(a,x,y,Color(0.72,0.65,0.54),Color(0.47,0.40,0.29))
			crown(a,x,y)
			a.rect(x-3,y+5,7,16,"gold")
			a.rect(x+22,y-14,4,38,"text")
			a.rect(x+16,y+12,16,4,"gold")
